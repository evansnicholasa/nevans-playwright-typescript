{
  "name": "nevans-playwright-typescript",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable Playwright + TypeScript test framework with a Dockerized demo app covering UI, API, database, and message-queue tests.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bddgen": "bddgen",
    "test": "bddgen && playwright test",
    "test:loop": "tsc && node --test dist/loop/config.test.js",
    "loop:agent": "tsc && node dist/loop/run.js",
    "test:headed": "bddgen && playwright test --headed",
    "report:html": "playwright show-report",
    "report:allure": "npx allure generate allure-results --clean -o allure-report && npx allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/amqplib": "^0.10.7",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.11",
    "allure-commandline": "^2.34.0",
    "allure-playwright": "^3.12.1",
    "amqplib": "^0.10.7",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "playwright-bdd": "^9.2.0",
    "typescript": "^5.8.2",
    "zod": "^3.24.2"
  }
}
